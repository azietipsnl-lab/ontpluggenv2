# Sanity — copy to .env and fill in.
# Find these after running `npx sanity login` then creating a project,
# or from https://www.sanity.io/manage (Project → API).

# Your Sanity project ID (e.g. "ab12cd34")
PUBLIC_SANITY_PROJECT_ID=""

# Dataset name (usually "production")
PUBLIC_SANITY_DATASET="production"

# Canonical site URL — used for sitemap, RSS, and absolute links.
# No trailing slash. Use your production domain when deploying.
PUBLIC_SITE_URL="http://localhost:4321"
