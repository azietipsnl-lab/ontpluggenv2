---
import type { SiteSettings } from '../sanity/types';
import { resolveNavLink, isExternal } from '../lib/links';

interface Props {
	settings: SiteSettings | null;
}

const { settings } = Astro.props;

const siteTitle = settings?.title ?? 'Ontpluggen';
const description = settings?.description;
const footerNav = settings?.footerNav ?? [];
const social = settings?.social ?? [];
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<p class="site-footer__title">{siteTitle}</p>
			{description && <p class="site-footer__desc">{description}</p>}
		</div>

		<div class="site-footer__links">
			{
				footerNav.length > 0 && (
					<nav aria-label="Footernavigatie">
						<ul>
							{footerNav.map((link) => {
								const href = resolveNavLink(link);
								const external = isExternal(href);
								return (
									<li>
										<a
											href={href}
											{...(external
												? { target: '_blank', rel: 'noopener noreferrer' }
												: {})}
										>
											{link.label}
										</a>
									</li>
								);
							})}
						</ul>
					</nav>
				)
			}

			{
				social.length > 0 && (
					<ul class="site-footer__social">
						{social.map((s) => (
							<li>
								<a href={s.url} target="_blank" rel="noopener noreferrer">
									{s.platform}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>

	<div class="container site-footer__bottom">
		<p>© {year} {siteTitle}. Alle rechten voorbehouden.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-32);
		border-top: 1px solid var(--border);
		background-color: var(--bg-elevated);
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-12);
		padding-block: var(--space-16) var(--space-8);
	}

	.site-footer__title {
		font-family: var(--font-display);
		font-size: var(--text-lg);
	}

	.site-footer__desc {
		color: var(--text-muted);
		max-width: 32ch;
		margin-top: var(--space-2);
	}

	.site-footer__links {
		display: flex;
		gap: var(--space-16);
		flex-wrap: wrap;
	}

	.site-footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.site-footer a {
		color: var(--text-muted);
		font-size: var(--text-sm);
	}

	.site-footer a:hover {
		color: var(--accent);
	}

	.site-footer__bottom {
		padding-block: var(--space-6);
		border-top: 1px solid var(--border);
	}

	.site-footer__bottom p {
		font-size: var(--text-xs);
		color: var(--text-muted);
	}
</style>
