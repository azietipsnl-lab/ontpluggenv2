---
import { toHTML, type PortableTextComponents } from '@portabletext/to-html';
import type { PortableTextBlock } from '@portabletext/types';
import { urlFor } from '../sanity/image';

interface Props {
	value: PortableTextBlock[] | undefined | null;
}

const { value } = Astro.props;

const components: PortableTextComponents = {
	types: {
		image: ({ value }) => {
			if (!value?.asset) return '';
			const url = urlFor(value).width(1200).fit('max').auto('format').url();
			const alt = value.alt ?? '';
			return `<img src="${url}" alt="${alt}" loading="lazy" decoding="async" />`;
		},
	},
	marks: {
		link: ({ children, value }) => {
			const href = value?.href ?? '#';
			const external = /^https?:\/\//.test(href);
			const rel = external ? ' rel="noopener noreferrer" target="_blank"' : '';
			return `<a href="${href}"${rel}>${children}</a>`;
		},
	},
};

const html = value ? toHTML(value, { components }) : '';
---

{html && <div class="prose" set:html={html} />}

<style>
	.prose {
		max-width: var(--container-narrow);
		line-height: var(--leading-normal);
	}

	.prose :global(> * + *) {
		margin-top: var(--space-4);
	}

	.prose :global(h2) {
		font-size: var(--text-2xl);
		margin-top: var(--space-12);
	}

	.prose :global(h3) {
		font-size: var(--text-xl);
		margin-top: var(--space-8);
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--accent);
		padding-left: var(--space-4);
		color: var(--text-muted);
		font-style: italic;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: var(--space-6);
	}

	.prose :global(li + li) {
		margin-top: var(--space-2);
	}

	.prose :global(img) {
		border-radius: var(--radius-md);
		margin-block: var(--space-8);
	}
</style>
