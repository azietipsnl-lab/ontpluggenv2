---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadQuery } from '../sanity/load';
import { siteSettingsQuery } from '../sanity/queries';
import type { SiteSettings, SeoData } from '../sanity/types';

interface Props {
	title?: string;
	description?: string;
	/** Per-page SEO from Sanity; overrides title/description when present. */
	seo?: SeoData;
	/** Render without the site chrome (header/footer). */
	bare?: boolean;
}

const { title, description, seo, bare = false } = Astro.props;

// Site-wide settings (nav, defaults). Null-safe if no content exists yet.
let settings: SiteSettings | null = null;
try {
	settings = await loadQuery<SiteSettings | null>(siteSettingsQuery);
} catch {
	settings = null;
}

const siteName = settings?.title ?? 'Ontpluggen';
const defaultDescription =
	settings?.description ??
	'Een premium platform voor digitaal welzijn. Ontkoppel bewust, leef met aandacht.';

const resolvedTitle = seo?.metaTitle ?? title ?? siteName;
const fullTitle =
	resolvedTitle === siteName ? resolvedTitle : `${resolvedTitle} — ${siteName}`;
const resolvedDescription =
	seo?.metaDescription ?? description ?? defaultDescription;
const ogImage = seo?.ogImage?.url ?? settings?.seo?.ogImage?.url;
const noIndex = seo?.noIndex ?? false;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={resolvedDescription} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={Astro.url.href} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Ontpluggen — Magazine"
			href="/rss.xml"
		/>

		<meta name="theme-color" content="#2e5e4e" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={resolvedDescription} />
		<meta property="og:url" content={Astro.url.href} />
		{ogImage && <meta property="og:image" content={ogImage} />}
	</head>
	<body>
		{!bare && <Header settings={settings} />}
		<slot />
		{!bare && <Footer settings={settings} />}
	</body>
</html>
